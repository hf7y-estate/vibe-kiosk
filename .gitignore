# Python virtualenv - never commit this, see README for setup
.venv/
__pycache__/
*.pyc

# data/: runtime outputs (scans, exports, logs, prints, debug overlays).
# Regenerated by run_pipeline.py / analysis tools; not source. See README.
data/

# Ad-hoc debug images written to the repo root by scripts under tools/
# (tools/test_fiducials.py, tools/find_bubble_candidates.py, etc. hardcode
# these relative filenames instead of writing into data/). Regenerate by
# rerunning the corresponding tool.
/debug_*.png
/*_debug.png
/*_candidates.png
